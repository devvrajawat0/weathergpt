# WeatherGPT - SIH Project Environment Variables

# AI Chat API (Groq Llama 3.1 - Free tier)
GROQ_API_KEY=your_groq_api_key_here

# Text to Speech API Keys (Optional - Falls back to Browser Web Speech API)
SARVAM_API_KEY=your_sarvam_ai_api_key_here
GOOGLE_CLOUD_TTS_KEY=your_google_cloud_tts_key_here

# Backup Weather API (Optional - Open-Meteo requires no key)
OPENWEATHER_API_KEY=your_openweather_key_optional

# MongoDB Atlas URI (Optional - For storing Trip Planner itineraries)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/weather_gpt
